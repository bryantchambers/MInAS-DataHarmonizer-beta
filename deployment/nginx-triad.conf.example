# Include inside the HTTPS server block that serves DataHarmonizer.
# Set root to the built web/dist directory from this repository.
root /srv/minas/MInAS-DataHarmonizer/web/dist;
index index.html;

location /api/v1/mvp/triad/ {
    proxy_pass http://127.0.0.1:8766/v1/mvp/triad/;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
}

location / {
    try_files $uri $uri/ =404;
}
